# Build outputs and dependencies are rebuilt inside the image.
target/
**/target/
frontend/node_modules/
**/node_modules/
frontend/dist/
.git/
.github/
.idea/
.vscode/
*.iml
**/__pycache__/

# Never send secrets or data into a build context.
.env
app.env
.env.*
!frontend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
secrets/
backups/
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.log
# Root-level dumps only: src/main/resources/db/migration/*.sql must stay in the context.
/*.sql
/*.sql.gz

# Not needed at build time.
docs/
BACKEND-REVIEW.txt
HELP.md
docker-compose*.yml
