# Rendered by the nginx image at start-up; ${API_UPSTREAM} is the only substituted variable.
#
# Routing follows docs/production-readiness.md and the Vite preview server:
#   /                         index.html (indexable homepage)
#   client routes             app.html, status 200 (keep in step with frontend/src/seo/routes.ts)
#   real files                served directly; /assets/* are fingerprinted and cached for a year
#   anything else             404.html, status 404
#   /api, /oauth2, /login/oauth2   proxied to the Spring Boot app
# /management (actuator) is deliberately not proxied.

map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 50m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/          { proxy_pass http://${API_UPSTREAM}; include /etc/nginx/snippets/proxy.inc; }
    location ^~ /oauth2/       { proxy_pass http://${API_UPSTREAM}; include /etc/nginx/snippets/proxy.inc; }
    location ^~ /login/oauth2/ { proxy_pass http://${API_UPSTREAM}; include /etc/nginx/snippets/proxy.inc; }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Client-side routes: frontend/src/seo/routes.ts isAppRoute().
    location ~ "^/(discover|admin/city-discovery|admin/listing-claims|admin/spa-leads|staff/media|packages|me/packages|spas|auth/login|auth/register|auth/otp|auth/email-link|auth/password|auth/social/callback|me/bookings|me/settings|privacy|terms)/*$" {
        try_files /app.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/(discover/places/[^/]+|(spas|features|b)/[^/]+)/*$" {
        try_files /app.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/(booking|owner)(/.*)?$" {
        try_files /app.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /app.html { internal; }
    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }

    error_page 404 /404.html;
}
