# Keep empty for the Vite same-origin API proxy.
VITE_API_BASE_URL=
# Start the current backend on this port (the earlier room demo uses 8080).
API_PROXY_TARGET=http://localhost:8081
# Set the approved HTTPS origin only when building for production.
VITE_PUBLIC_SITE_URL=
# Optional same-origin POST collector. Measurement requires opt-in on /privacy.
VITE_ANALYTICS_PATH=
