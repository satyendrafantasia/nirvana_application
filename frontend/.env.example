# Keep empty for the Vite same-origin API proxy.
VITE_API_BASE_URL=
# For a bundled cross-site WebView, memory keeps both tokens in RAM. Capacitor native selects it automatically.
# Leave empty for the normal same-site HTTPS browser session.
VITE_AUTH_TRANSPORT=
# Start the current backend on this port (the earlier room demo uses 8080).
API_PROXY_TARGET=http://localhost:8081
# Set the approved HTTPS origin only when building for production.
VITE_PUBLIC_SITE_URL=
# Optional same-origin POST collector. Measurement requires opt-in on /privacy.
VITE_ANALYTICS_PATH=

# Optional: browser key for the free Google Maps Embed API, restricted to this site's address.
# Shows a map in the Location section of each spa page; without it only the Google Maps buttons show.
VITE_GOOGLE_MAPS_EMBED_KEY=
