# Application settings passed straight to the app container. Copy to app.env (git-ignored).
# Database, Redis, JWT and forwarding settings come from docker-compose.yml / .env instead.
# Every variable is described in docs/operations.md; leave a line out to use the default.

SPRING_PROFILES_ACTIVE=
API_DOCS_ENABLED=false
LEGACY_REGISTRATION_ENABLED=false

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMS_PROVIDER=AWS_SNS
SPA_ALERTS_ENABLED=true
# Set true to use SNS for booking messages independently of the mobile OTP provider.
SPA_BOOKING_SMS_ENABLED=
FIREBASE_PUSH_ENABLED=false
FIREBASE_WEB_PUSH_PUBLIC_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
SPA_SMS_SENDER_ID=
SPA_SMS_DLT_ENTITY_ID=
SMS_TEMPLATE_OTP=

GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

TRACING_SAMPLING_PROBABILITY=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
