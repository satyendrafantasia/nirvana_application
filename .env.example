# Compose-level settings for docker-compose.yml. Copy to .env (git-ignored) and fill in.
# Generate passwords and the JWT secret, for example:  openssl rand -base64 36

DB_NAME=nirvana
DB_APP_USER=nirvana
DB_APP_PASSWORD=
DB_ROOT_PASSWORD=
# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=

# Set false only for a local demo database that should publish its fictional spas.
INVENTORY_HIDE_FIXTURES=true

WEB_PORT=8088
FRONTEND_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088

# Frontend build arguments (baked into the web image). Empty = preview build, not indexed.
VITE_PUBLIC_SITE_URL=
# Approved public operator identity and support inbox, displayed on privacy and booking terms.
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=contact@nirvana-spa.in
VITE_GOOGLE_MAPS_EMBED_KEY=
VITE_ANALYTICS_PATH=

# Backups (container "backup"). Daily at BACKUP_AT in Asia/Kolkata time.
BACKUP_AT=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_HOST_DIR=./backups
# Set true with a versioned S3 bucket and an external monitor in production.
# The job exits 2 if the required off-host copy cannot be completed.
BACKUP_REQUIRE_REMOTE=false
BACKUP_HEARTBEAT_URL=
BACKUP_FAILURE_URL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=nirvana/db
AWS_REGION=ap-south-1
# The backup image can use an EC2 instance role. Static keys are optional.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_SESSION_TOKEN=
